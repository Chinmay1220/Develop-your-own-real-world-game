# Copy this file to .env and fill in your key. Never commit .env.
# Get a key from the Meta Model API dashboard after claiming the hackathon credits.
MODEL_API_KEY=

# Optional settings (the defaults are shown).
# AI_MODE=meta              # "meta" when MODEL_API_KEY is set, otherwise "offline"
